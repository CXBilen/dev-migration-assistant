{
  "name": "@devmig/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Dev Migration Assistant — Migration Assistant, but for developers.",
  "productName": "Dev Migration Assistant",
  "author": "Cem Bilen",
  "license": "MIT",
  "homepage": "https://github.com/CXBilen/dev-migration-assistant",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.yml",
    "dist:mac:universal": "electron-vite build && electron-builder --mac --universal --config electron-builder.yml"
  },
  "dependencies": {
    "@devmig/archive": "workspace:*",
    "@devmig/core": "workspace:*",
    "@devmig/ipc-contracts": "workspace:*",
    "@devmig/model": "workspace:*",
    "@devmig/provider-claude-code": "workspace:*",
    "@devmig/provider-git": "workspace:*",
    "@devmig/provider-project-files": "workspace:*",
    "@devmig/provider-runtime": "workspace:*",
    "@devmig/shared": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
